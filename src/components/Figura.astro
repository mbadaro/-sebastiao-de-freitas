---
/**
 * Imagem com legenda, crédito e selo de tipo (T024; FR-021; D8).
 * - ilustracao       → selo "Ilustração"
 * - fotografia-atual → selo "Fotografia atual" (com data, quando houver)
 * - historica        → sem selo; identificada pela legenda e pela referência
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagem: ImageMetadata;
  alt: string;
  legenda: string;
  credito: string;
  tipo: 'historica' | 'fotografia-atual' | 'ilustracao';
  dataFoto?: string;
  /** true para imagens no topo da página (carregamento imediato). */
  prioridade?: boolean;
  larguras?: number[];
}

const {
  imagem,
  alt,
  legenda,
  credito,
  tipo,
  dataFoto,
  prioridade = false,
  larguras = [480, 800, 1200],
} = Astro.props;

const selo =
  tipo === 'ilustracao'
    ? 'Ilustração'
    : tipo === 'fotografia-atual'
      ? dataFoto
        ? `Fotografia atual, ${dataFoto}`
        : 'Fotografia atual'
      : null;
---

<figure class="figura">
  <Picture
    src={imagem}
    alt={alt}
    widths={larguras}
    sizes="(max-width: 48rem) 100vw, 48rem"
    formats={['avif', 'webp']}
    loading={prioridade ? 'eager' : 'lazy'}
    fetchpriority={prioridade ? 'high' : 'auto'}
  />
  <figcaption class="figura__legenda">
    {selo && <span class="figura__selo">{selo}</span>}
    <span>{legenda}</span>
    <span class="figura__credito">{credito}</span>
  </figcaption>
</figure>

<style>
  .figura {
    margin: 0;
  }
  .figura :global(img) {
    width: 100%;
    border-radius: var(--raio);
  }
  .figura__legenda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1) var(--esp-2);
    margin-top: var(--esp-2);
    font-size: var(--texto-pequeno);
    color: var(--texto-secundario);
  }
  .figura__selo {
    padding: 0 0.5em;
    border: var(--linha-fina) solid currentColor;
    border-radius: var(--raio);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .figura__credito {
    flex-basis: 100%;
    font-style: italic;
  }
</style>
