---
/**
 * Seção "Lugares e caminhos" da página inicial (T031, T069).
 * Usa a vista "atlantico" gerada a partir de lugares.yaml e trajetos.yaml (mesmo mapa de /mapa/).
 * A lista ao lado é a alternativa textual do mapa (FR-016).
 */
import type { CollectionEntry } from 'astro:content';
import Secao from './Secao.astro';
import Mapa from './Mapa.astro';
import { gerarMapa } from '../lib/mapa';
import { url } from '../lib/url';

interface Props {
  lugares: CollectionEntry<'lugares'>[];
}
const { lugares } = Astro.props;
// Mesma numeração do mapa.
const ordem = (await gerarMapa('atlantico')).pontos;
const lista = ordem.map((p) => ({ n: p.n, l: lugares.find((l) => l.id === p.id)! })).filter((x) => x.l);
---

<Secao superficie="escura" rotuloId="lugares-titulo">
  <div class="grade">
    <div class="texto">
      <p class="sobretitulo">Lugares e caminhos</p>
      <h2 id="lugares-titulo">Do Algarve à vila de São Paulo</h2>
      <p>
        A travessia do Atlântico e a vida na capitania de São Vicente, nos lugares registrados
        pelas fontes.
      </p>
      <ol class="lugares">
        {
          lista.map(({ n, l }) => (
            <li>
              <span class="lugares__numero" aria-hidden="true">{n}</span>
              <span>
                <a href={url(`lugares/${l.id}/`)}><strong>{l.data.nome_historico}</strong></a>{' '}
                <span class="lugares__pais">({l.data.pais === 'portugal' ? 'Portugal' : 'Brasil'})</span>
              </span>
            </li>
          ))
        }
      </ol>
      <p class="legenda">
        <span class="legenda__linha" aria-hidden="true"></span>
        Trajeto presumido: as fontes registram os lugares, não o percurso.
      </p>
      <a class="botao" href={url('mapa/')}>Explorar o mapa</a>
    </div>

    <Mapa vista="atlantico" destino="pagina" />
  </div>
</Secao>

<style>
  .grade {
    display: grid;
    gap: var(--esp-6);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .lugares {
    list-style: none;
    padding: 0;
    margin: var(--esp-5) 0;
    display: grid;
    gap: var(--esp-3);
  }
  .lugares li {
    display: flex;
    gap: var(--esp-3);
    align-items: center;
  }
  .lugares__numero {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--cor-dourado);
    color: var(--cor-azul-profundo);
    font-weight: 700;
  }
  .lugares__pais {
    color: var(--texto-secundario);
  }
  .legenda {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
    font-size: var(--texto-pequeno);
    color: var(--texto-secundario);
    margin-bottom: var(--esp-4);
  }
  .legenda__linha {
    flex: none;
    width: 2.5rem;
    border-top: 2px dashed var(--cor-dourado);
  }
</style>
