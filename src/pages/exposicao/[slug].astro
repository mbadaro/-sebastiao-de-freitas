---
/** Capítulo da exposição (T050; US1). Endereço permanente: /exposicao/<slug>/ (FR-003). */
import LayoutBase from '../../layouts/LayoutBase.astro';
import NavegacaoCapitulos from '../../components/NavegacaoCapitulos.astro';
import ListaCitacoes from '../../components/ListaCitacoes.astro';
import { capitulosOrdenados, montarCapitulo } from '../../lib/capitulo';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const capitulos = await capitulosOrdenados();
  return capitulos.map((c, i) => ({
    params: { slug: c.data.slug },
    props: {
      entrada: c,
      numero: i + 1,
      total: capitulos.length,
      anterior: capitulos[i - 1] && { slug: capitulos[i - 1].data.slug, titulo: capitulos[i - 1].data.titulo },
      proximo: capitulos[i + 1] && { slug: capitulos[i + 1].data.slug, titulo: capitulos[i + 1].data.titulo },
    },
  }));
}

const { entrada, numero, total, anterior, proximo } = Astro.props;
const { html, citacoes } = await montarCapitulo(entrada);
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entrada.data.titulo,
      description: entrada.data.descricao,
      inLanguage: 'pt-BR',
      about: { '@type': 'Person', name: 'Sebastião de Freitas' },
      url: new URL(Astro.url.pathname, site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(url(), site).href },
        { '@type': 'ListItem', position: 2, name: 'Exposição', item: new URL(url('exposicao/'), site).href },
        { '@type': 'ListItem', position: 3, name: entrada.data.titulo },
      ],
    },
  ],
};
---

<LayoutBase titulo={entrada.data.titulo} descricao={entrada.data.descricao} tipo="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="cabeca-capitulo superficie-escura">
    <div class="conteiner">
      <nav aria-label="Você está em" class="trilha">
        <a href={url()}>Início</a>
        <span aria-hidden="true">&nbsp;›&nbsp;</span>
        <a href={url('exposicao/')}>Exposição</a>
      </nav>
      <p class="sobretitulo">Capítulo {numero} de {total}</p>
      <h1>{entrada.data.titulo}</h1>
      <p class="cabeca-capitulo__descricao">{entrada.data.descricao}</p>
    </div>
  </header>

  <article class="conteiner capitulo">
    <div class="texto-capitulo" set:html={html} />
    <ListaCitacoes citacoes={citacoes} />
    <NavegacaoCapitulos anterior={anterior} proximo={proximo} />
  </article>
</LayoutBase>

<style>
  .cabeca-capitulo {
    padding-block: var(--esp-6) var(--esp-5);
  }
  .cabeca-capitulo h1 {
    font-size: var(--titulo-2);
  }
  .cabeca-capitulo__descricao {
    color: var(--texto-secundario);
    font-size: var(--texto-destaque);
    max-width: 48ch;
  }
  .trilha {
    font-size: var(--texto-pequeno);
    margin-bottom: var(--esp-4);
    color: var(--texto-secundario);
  }
  .capitulo {
    padding-block: var(--esp-5) var(--esp-6);
    max-width: calc(var(--largura-leitura) + 2 * var(--margem-lateral));
  }
</style>
