---
/**
 * Página inicial (T034, T053). Textos de abertura em conteudo/paginas/inicio.md;
 * marcos e lugares vêm das coleções (acontecimentos, lugares).
 */
import LayoutBase from '../layouts/LayoutBase.astro';
import Hero from '../components/Hero.astro';
import PreviaTrajetoria from '../components/PreviaTrajetoria.astro';
import PreviaLugares from '../components/PreviaLugares.astro';
import Secao from '../components/Secao.astro';
import DestaqueDocumento from '../components/DestaqueDocumento.astro';
import DescubraAHistoria from '../components/DescubraAHistoria.astro';
import { url } from '../lib/url';
import { verificarIntegridade } from '../lib/integridade';
import { getCollection, getEntry } from 'astro:content';
import { fontesCurtas } from '../lib/acervo';
import { formatarData } from '../lib/datas';

// Integridade do acervo: interrompe a geração do site se houver ligação quebrada (T044).
await verificarIntegridade();

// Lido pela coleção (respeita CONTEUDO_DIR nos testes de validação).
const p = (await getEntry('paginas', 'inicio'))!.data as Record<string, any>;

const marcos = await Promise.all(
  (p.destaques as string[]).map(async (id) => {
    const a = await getEntry('acontecimentos', id);
    if (!a) throw new Error(`inicio.md: acontecimento "${id}" não existe`);
    const fontes = await fontesCurtas(a.data.referencias);
    return {
      data: formatarData(a.data.data),
      titulo: a.data.titulo,
      natureza: a.data.natureza,
      fonte: fontes.map((f) => f.html).join('; '),
      href: url(`linha-do-tempo/#${a.id}`),
    };
  }),
);
const lugares = (await getCollection('lugares')).filter((l) => l.data.vista.includes('atlantico'));
---

<LayoutBase titulo={p.titulo} descricao={p.descricao}>
  <Hero
    sobretitulo={p.abertura.sobretitulo}
    apresentacao={p.abertura.apresentacao}
    sefardita={p.abertura.sefardita}
    fonteSefardita={p.abertura.fonte_sefardita}
  />

  <PreviaTrajetoria marcos={marcos} />

  <PreviaLugares lugares={lugares} />

  <Secao superficie="clara" rotuloId="documentos-titulo">
    <p class="sobretitulo">Documentos e evidências</p>
    <h2 id="documentos-titulo">O que sustenta esta história</h2>
    <p class="documentos__intro">
      Nada aqui é afirmado sem origem. Estas são algumas das obras que registram a trajetória de
      Sebastião de Freitas.
    </p>
    <ul class="documentos">
      {p.documentos.map((d: { tipo: string; titulo: string; autoria: string; texto: string; situacao: string }) => <li><DestaqueDocumento {...d} /></li>)}
    </ul>
    <p class="documentos__acoes">
      <a class="botao" href={url('fontes/')}>Ver todas as fontes</a>
    </p>
  </Secao>

  <DescubraAHistoria />
</LayoutBase>

<style>
  .documentos__intro {
    color: var(--texto-secundario);
    margin-bottom: var(--esp-5);
  }
  .documentos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--esp-4);
  }
  .documentos__acoes {
    margin-top: var(--esp-6);
  }
</style>
