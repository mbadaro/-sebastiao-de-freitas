---
/** Página "Raízes sefarditas" (T056; US2). Endereço permanente: /sefarditas/. */
import { getEntry } from 'astro:content';
import LayoutBase from '../layouts/LayoutBase.astro';
import ListaCitacoes from '../components/ListaCitacoes.astro';
import { montarCapitulo } from '../lib/capitulo';
import { url } from '../lib/url';

const entrada = await getEntry('paginas', 'sefarditas');
if (!entrada) throw new Error('conteudo/paginas/sefarditas.md não encontrado');
const titulo = entrada.data.titulo as string;
const descricao = entrada.data.descricao as string;
const { html, citacoes } = await montarCapitulo(entrada);
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: titulo,
      description: descricao,
      inLanguage: 'pt-BR',
      about: { '@type': 'Thing', name: 'Judeus sefarditas e cristãos-novos' },
      url: new URL(Astro.url.pathname, site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(url(), site).href },
        { '@type': 'ListItem', position: 2, name: titulo },
      ],
    },
  ],
};
---

<LayoutBase titulo={titulo} descricao={descricao} tipo="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="cabeca-pagina superficie-escura">
    <div class="conteiner">
      <nav aria-label="Você está em" class="trilha">
        <a href={url()}>Início</a>
      </nav>
      <p class="sobretitulo">Raízes sefarditas</p>
      <h1>{titulo}</h1>
      <p class="cabeca-pagina__descricao">{descricao}</p>
    </div>
  </header>

  <article class="conteiner pagina">
    <div class="texto-capitulo" set:html={html} />
    <ListaCitacoes citacoes={citacoes} />
  </article>
</LayoutBase>

<style>
  .cabeca-pagina {
    padding-block: var(--esp-6) var(--esp-5);
  }
  .cabeca-pagina h1 {
    font-size: var(--titulo-2);
  }
  .cabeca-pagina__descricao {
    color: var(--texto-secundario);
    font-size: var(--texto-destaque);
    max-width: 48ch;
  }
  .trilha {
    font-size: var(--texto-pequeno);
    margin-bottom: var(--esp-4);
    color: var(--texto-secundario);
  }
  .pagina {
    padding-block: var(--esp-5) var(--esp-6);
    max-width: calc(var(--largura-leitura) + 2 * var(--margem-lateral));
  }
</style>
